def scan_local_network():
    network = socket.gethostbyname(socket.gethostname())
    net = network.split('.')[:-1]
    net = '.'.join(net)
    print(f'Local network: {net}')
    for i in range(1, 255):
        ip = f'{net}.{i}'
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(0.5)
            s.connect((ip, 80))
            print(f'Device found: {ip}')
            s.close()
        except:
            pass

